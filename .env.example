# Copie para .env.local e preencha. NUNCA commite o arquivo preenchido.
# Este arquivo só tem os nomes das variáveis, nenhum valor secreto.

# Senha do painel, guardada como hash scrypt em base64.
# Gere com: npm run admin:senha
ADMIN_PASSWORD_HASH=

# Chave que assina o cookie de sessão. Mínimo 32 caracteres aleatórios.
# Gere com: openssl rand -base64 48
ADMIN_SESSION_SECRET=

# Fine-grained PAT do GitHub com permissão "Contents: read and write".
# Não use o GITHUB_TOKEN do repositório: push feito com ele pode não
# disparar a Action que regenera o portfólio.
GITHUB_TOKEN=

# Opcional. Sem isto, o padrão é o repositório deste deploy.
GITHUB_REPO=jassonmouragt-prog/lineareco
GITHUB_BRANCH=master
